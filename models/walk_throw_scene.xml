<mujoco model="g1_walk_throw">
  <include file="../mujoco_menagerie/unitree_g1/g1.xml"/>

  <!-- Must follow the include so the mesh path resolves from this project. -->
  <compiler meshdir="../mujoco_menagerie/unitree_g1/assets/"/>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="30 30 0.1"
          contype="1" conaffinity="3" friction="0.8 0.02 0.001"
          rgba="0.24 0.26 0.30 1"/>

    <camera name="side" pos="2 -6 1.6" xyaxes="1 0 0  0 0.3 1"/>
    <camera name="behind" pos="-3 0 1.8" xyaxes="0 -1 0  0.3 0 1"/>
    <camera name="follow" mode="trackcom" pos="-3 -3 1.8"
            xyaxes="0.7 -0.7 0  0.2 0.2 1"/>

    <body name="ball" pos="-0.017 -0.222 0.721">
      <freejoint name="ball_free"/>
      <geom name="ball_geom" type="sphere" size="0.02" mass="0.05"
            contype="2" conaffinity="2" rgba="1 0.35 0.05 1"/>
    </body>

    <site name="target" pos="4 0 0.01" type="cylinder" size="0.3 0.005"
          rgba="0 1 0 0.55"/>
  </worldbody>

  <equality>
    <!-- No pelvis weld: balance is part of the Level-3 task. -->
    <weld name="grip" body1="right_wrist_yaw_link" body2="ball"
          relpose="0.145 0 0 1 0 0 0" solref="0.001 1"/>
  </equality>

  <statistic center="2 0 0.8" extent="10"/>
  <visual>
    <global azimuth="140" elevation="-15"/>
  </visual>
</mujoco>
